---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
const pageTitle = "The Digital Forest";
import Footer from "../components/Footer.astro";
import BlogPost from "../components/BlogPost.astro";

const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---
<style>
body {
    background-image: url("/images/treeba home bck.png");
    background-color: var(--primary-orange);
    background-size: cover;
    background-repeat: no-repeat;
    
  }
  </style>
<BaseLayout currentLocale={currentLocale}>
  <Navigation/>
<BlogPost/>
<Footer/>
</BaseLayout>

