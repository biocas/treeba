---
// here I want a really throwback page again with a cute graphic + copy "We are about to go forage on my digital forest. See what it takes you + button that takes you onto a random post page whatever on this website"
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
const pageTitle = "Forage";
import HomepageCard from "../layouts/homepageCard.astro";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() { 
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---

<style>
    h1 {
        text-align: center;
    }
  body {
    background-image: url("/images/rootsBckHome.png");
    background-color: #FF4E00;
    background-size: cover;
    background-repeat: no-repeat;
    height: 100%;
    max-height: 100vh;
    margin: 0;
  }
  .treebaLogo {
    width: 30vw;
  }
  .container {
    display: flex;
    flex-flow: column nowrap;
    margin: 1rem 2rem 3rem 4rem;
    align-items: center;
  }
  .pagesGrid {
    display: flex;
    flex-flow: row wrap;
    width: 70vw;
    justify-content: space-between;
    align-items: center;
    gap: 20px 20px;
  }
  .scroll-container {
  border: 3px solid black;
  background-color: var(--primary-orange);
  overflow: hidden;
}
  .mainHomepageSection {
    background-color: var(--background-cream);
    border: 2px solid var(--primary-green);
    padding: 20px;
    border-radius: 20px;
    box-shadow: 10px 10px var(--primary-green);
    display: flex;
    align-items: center;
    flex-flow: column wrap;
    gap: 10px;
  }
  .homeAboutText {
    color: var(--dark-brown);
  }
  .cardWrapper {
    margin-top: 5rem;
    display: flex;
    align-items: center;
    flex-flow: column wrap;
    gap: 10px;
  }
  .cardWrapperBottom {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    flex-flow: row wrap;
    gap: 10px;
  }
  @media (max-width: 481px) {
    body {
    height: 100vh;
        max-height: none;
  }
  .container {
    gap: 0;
    margin: 1.5rem;
  }
.mainHomepageSection h5{
    margin: 1rem 0 1.5rem 0;
  }
  }
.scroll-text {
    white-space: nowrap;
  /* animation properties */
  -moz-transform: translateX(100%);
  -webkit-transform: translateX(100%);
  transform: translateX(100%);
  
  -moz-animation: my-animation 25s linear infinite;
  -webkit-animation: my-animation 25s linear infinite;
  animation: my-animation 25s linear infinite;
}

/* for Firefox */
@-moz-keyframes my-animation {
  from { -moz-transform: translateX(100%); }
  to { -moz-transform: translateX(-100%); }
}

/* for Chrome */
@-webkit-keyframes my-animation {
  from { -webkit-transform: translateX(100%); }
  to { -webkit-transform: translateX(-100%); }
}

@keyframes my-animation {
  from {
    -moz-transform: translateX(100%);
    -webkit-transform: translateX(100%);
    transform: translateX(100%);
  }
  to {
    -moz-transform: translateX(-100%);
    -webkit-transform: translateX(-100%);
    transform: translateX(-100%);
  }
}

  @media (max-width: 481px) {
    body {
    height: 100vh;
        max-height: none;
  }
   h1{
    margin: 0.5rem 0 0.5rem 0;
  }
  .pagesGrid {
    gap: 10px;
    justify-content: space-evenly;
  }

  }
</style>

<BaseLayout currentLocale={currentLocale}>
    <div class="scroll-container">
<div class="scroll-text">
        <h5 class="whiteAndStroke">Digital woodlands where regenerative work germinates and grows, fruits
        and decays, eventually composting, circling in tender connections and
        the hopeful flow of gifts. Focused on the Iberian Peninsula.</h5>
</div>
    </div>
  <div class="container">
      <h1 class="whiteAndStroke">{pageTitle}</h1>
      
      <div class="pagesGrid">
        <HomepageCard image="/images/favicon.svg" href="/lore/" name="Lore" />
        <HomepageCard image="/images/forest.svg" href="forest/" name="Forest" />
        <HomepageCard image="/images/map.svg" href="/map/" name="Map" />
        <HomepageCard
          image="/images/bee.svg"
          href="/bookshelf/"
          name="Books"
        />
        <HomepageCard image="/images/berry.svg" href="/forage/" name="Forage" />
        <HomepageCard
          image="/images/flower.svg"
          href="/margarida/"
          name="About"
        />
      </div>
  </div>
<section class="mainHomepageSection">
      <img class="treebaLogo" alt="Treeba" src="/images/Treeba.svg">
      <h5 class="homeAboutText">
        Digital woodlands where regenerative work germinates and grows, fruits
        and decays, eventually composting, circling in tender connections and
        the hopeful flow of gifts. Focused on the Iberian Peninsula.
      </h5>
    
    </section>
</BaseLayout>
