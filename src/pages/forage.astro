---
// image from https://archive.org/details/ida_rentoul_outhwaite_frog_fairy_talking 
/* “Ask permission of the ones whose lives you seek.
Abide by the answer.
Never take the first.
Never take the last.
Harvest in a way that minimizes harm.
Take only what you need and leave some for others.
Use everything that you take.
Take only that which is given to you.
Share it, as the Earth has shared with you.
Be grateful.
Reciprocate the gift.
Sustain the ones who sustain you, and the Earth will last forever.”
Robin Wall Kimmerer
*/
// here I want a really throwback page again with a cute graphic + copy "We are about to go forage on my digital forest. See what it takes you + button that takes you onto a random post page whatever on this website"
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
const pageTitle = "Forage";
import HomepageCard from "../layouts/homepageCard.astro";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
import { getCollection } from "astro:content";
const posts = await getCollection("blog");
---

<style>
@keyframes faeFly {
	0% {
		transform: translate(-40vw, 2vh) rotate(0);
    opacity: 1;
	}
	50% {
		transform: translate(0vw, 0) rotate(30deg);
    opacity: 0.1;
	}
	100% {
		transform: translate(80vw, 4vh);
    opacity: 1;
	}
}
body {
  max-height: 100vh;
  overflow: hidden;
}

 .whimsyTitle {
  width: 80vw;
 }
 .bckImage {
  position: absolute;
  width: 100vw;
  height: 100vh;
  z-index: -1;
 filter: brightness(0.5) hue-rotate(45deg);
 }
 .frogImg {
animation: faeFly 8s linear reverse infinite;
 }
 .container {
    align-items: center;
    padding: 1rem 0 5rem;
 }
 @media only screen and (max-width: 767px) {
  .bckImage {
        object-fit: cover;
  }
 }
 
</style>

<BaseLayout currentLocale={currentLocale}>  
<img class="bckImage" src="https://dn710909.ca.archive.org/0/items/clevelandart-1978.52-trees-and-undergrowt/1978.52_full.jpg"/>
  <section class="container">
<img class="frogImg" src="/images/ida_rentoul_outhwaite_frog_fairy_talking 1.png" loading="lazy" alt="ida rentoul outhwaite frog_fairy talking">

  <h2 class="whimsyTitle"> We are about to go forage on my digital forest. Grab your basket, follow the Honourable Harvest and see where it takes you!</h2>
    <HomepageCard image="/images/basket.svg" href="" name="" id="basket" />
      </section>

</BaseLayout>
<!-- Link to the JavaScript file for interactivity -->
<script>
document.addEventListener('DOMContentLoaded', () => {
const posts = import.meta.glob('/src/content/blog/[^_]*.{md,mdx}')//relative to this component file
const postNames = Object.keys(posts);

const cleanNames = postNames.map(post => {
  return post.split('/').pop().replace(/\.(md|mdx)$/, "");
});
console.log(cleanNames);
const randomElement = cleanNames[Math.floor(Math.random() * cleanNames.length)];
const randomPage = "https://treeba.eu/blog/" + randomElement;
console.log(randomPage);
document.getElementById("basket").href = randomPage;
  
});


</script>