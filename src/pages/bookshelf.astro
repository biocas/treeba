---
import { getCollection } from "astro:content";
const resources = await getCollection("resources");
const publishedBooks = resources.filter((resource) => (!resource.data.draft) && (resource.data.type == "book"));
const publishedCourses = resources.filter((resource) => (!resource.data.draft) && (resource.data.type == "course"));
const publishedLinks = resources.filter((resource) => (!resource.data.draft) && (resource.data.type == "link"));
const publishedMaps = resources.filter((resource) => (!resource.data.draft) && (resource.data.type == "map"));

const { slug, cover, title, growthStage, date, description, id } = Astro.props;
const now = Date.now();

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
const pageTitle = "Resources";
import Footer from "../components/Footer.astro";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
//add a form so people suggest resources
// add a form in individual blog post page that redirects to my email
//rss feed
//bck source -https://giphy.com/gifs/sky-night-11kn6DFp9BNqWA - background-image: url("/images/Night Sky Star GIF.gif");
---

<style>
  body {
    margin: 0;
    overflow: hidden;
  }
  .containerScrollonScreen {
    background-image: url("/images/resourcesBck.png");
    background-color: var(--primary-orange);
  }
  h1 {
    font-family: var(--treeba-font);
    margin-top: 0;
    color: var(--primary-yellow);
    -webkit-text-stroke-width: 1px;
    -webkit-text-stroke-color: var(--primary-orange);
    font-size: 12rem;
    -moz-osx-font-smoothing: grayscale;
    font-weight: 100;
    margin-bottom: 0;
    text-align: center;
  }
  .resources-section {
    padding: 0 5rem;
  }
  h3 {
    -webkit-text-stroke-color: var(--primary-orange);
  filter: drop-shadow(0px 1px 0px #F46803);
  }
</style>

<BaseLayout currentLocale={currentLocale}>
  <div class="containerScrollonScreen">
    <div class="containFooter">
      <Header />
      <h1 class="mainTreebaTitle">{pageTitle}</h1>
      <section class="resources-section">
        <h3 class="resourcesCategories wackyTitle">Books</h3>
        <div class="resourceList">
          {publishedBooks.map((resource) => (
            <div class="moonHover">
              <h4>{resource.data.title}</h4>
            </div>
          ))}
        </div>
      </section>
      <section class="resources-section">
        <div class="resourceList">
          <h3 class="resourcesCategories wackyTitle">Courses</h3>
          {publishedCourses.map((resource) => (
            <div class="moonHover">
              <h4>{resource.data.title}</h4>
            </div>
          ))}
        </div>
      </section>
      <section class="resources-section">
        <div class="resourceList">
          <h3 class="resourcesCategories wackyTitle">Links</h3>
          {publishedLinks.map((resource) => (
            <div class="moonHover">
              <h4>{resource.data.title}</h4>
            </div>
          ))}
        </div>
      </section>
      <section class="resources-section">
        <div class="resourceList">
          <h3 class="resourcesCategories wackyTitle">Maps</h3>
          {publishedMaps.map((resource) => (
            <div class="moonHover">
              <h4>{resource.data.title}</h4>
            </div>
          ))}
        </div>
      </section>

      <Footer />
    </div>
  </div>
</BaseLayout>
