---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle =
  "Centrais Solares e interação com zonas de interesse ambiental e cultural";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---

<link
  href="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.css"
  rel="stylesheet"
/>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.js"
></script>

<style>
  #solar-map {
    height: 100vh;
    width: 100%;
    flex: 1;
  }
  body {
    background-color: var(--background-cream);
    background-size: cover;
    background-repeat: no-repeat;
    height: 100%;
    max-height: 100vh;
    margin: 0;
  }
  #divider {
  width: 5px;
  cursor: col-resize;
  background: #ccc;
}
  .prop-publica1,
  .site_code,
  .gid,
  .publica1 {
    display: none !important;
  }
  .lightboxOverlay {
  display: none; /* Hidden by default */
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0,0,0,0.8);
  justify-content: center;
  align-items: center;
  z-index: 9999; /* Above Mapbox */
  cursor: zoom-out;
}

.lightboxImage {
  max-width: 95%;
  max-height: 95%;
  border-radius: 8px;
}
  #container {
    display: flex;
    flex-flow: row nowrap;
    height: 100vh;
    overflow: hidden;
  }
  #mainHomepageSection {
    padding: 1rem;
    width: 40%;
    height: 100%; /* fill vertical space */
    overflow-y: auto; /* only this scrolls */
    box-sizing: border-box;
    font-family: var(--text-font);
  }
  
  #mainHomepageSection h1 {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--dark-brown);
  }
  #mainHomepageSection h2 {
    font-size: 1.2rem;
    color: whitesmoke;
  }
  #mainHomepageSection h5 {
    font-size: 1rem;
  }
  /* Icon key list */
  #mainHomepageSection ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  #fontes li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  #fontes a, #sophia a, #recursos a, #consultas a{
    color: black;
    font-weight: bold;
  }
  #fontes a:hover, #sophia a:hover, #recursos a:hover, #consultas a:hover {
   color: blue;
  }
  
  .instructionsParticipa li, .listAnaliseRTE li {
    margin-bottom: 5px;
}
  /* --- Key Button --- */
  /* button (stick it bottom-right; swap to absolute if you want it inside a map container) */
  .legenda-toggle {
    z-index: 1;
    position: absolute;
    left: 2vw;
    top: 1rem;
    border: 0;
    padding: 0.4rem;
    border-radius: 0.6rem;
    background: var(--dark-brown);
    color: var(--background-cream);
    cursor: pointer;
    font-family: var(--text-font);
    border: 2px solid var(--dark-brown);
  }
  .legenda-toggle:hover {
    background: var(--background-cream);
    color: var(--dark-brown);
    border: 2px solid var(--dark-brown);
  }
  /* Popover */
  .legenda-popover[hidden] {
    display: none !important;
  }
  .legenda-popover {
    position: fixed; /* anchors to viewport; JS keeps it under the button */
    z-index: 9999;
    background: var(--background-cream);
    color: var(--dark-brown);
    border: 1px solid var(--background-cream);
    border-radius: 0.7rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
    padding: 0.6rem 0.6rem 1rem;
    width: min(250px, 85vw);
    max-height: 70vh;
    overflow: auto;
  }
  .legenda-x {
    position: absolute;
    right: 1rem;
    border: 0;
    background: transparent;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.35rem;
  }
  .legenda-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    font-family: var(--text-font);
    font-size: 10px;
  }
  .legenda-list li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.1rem 0.25rem;
  }
  .legenda-list img {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    object-fit: contain;
  }

  /* Dropdown Cards */
  .infoCard {
    overflow: hidden;
    margin-bottom: 2rem;
    border: 2px sold var(--dark-brown);
  }
  
  .infoHeadWrapper {
    cursor: pointer;
    display: flex;
    flex-flow: row nowrap;
    justify-content: space-between;
    align-items: center;
    background-color: var(--dark-brown);
    border-radius: 20px 20px 0px 0px;
    padding: 10px;
  }
  .infoHeadWrapper h2 {
    margin: 10px;
  }
  .infoHeadWrapper .arrow {
    color: whitesmoke;
    font-size: 1.5rem;
  }
  .contentContainer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    border: 2px solid transparent;
  }

  .infoCard.active .contentContainer {
    max-height: 100%; /* adjust based on your content */
    border: 2px solid var(--dark-brown);
    border-radius: 0px 0px 20px 20px;
    padding: 10px;
  }

  .arrow {
    transition: transform 0.3s ease;
  }

  .infoCard.active .arrow {
    transform: rotate(180deg);
  }
  /*filter */
  #filter-group {
  display: flex;
  flex-direction: column;
  gap: 6px; /* space between rows */
}

#filter-group input[type="checkbox"] {
  margin-right: 6px;
}

#filter-group label {
  display: inline-block;
}

  /* Media Queries - Phones */

  @media (max-width: 481px) {

    .legenda-toggle {
    left: 1rem;
    top: 1rem;
    padding: 0.4rem;
    border-radius: 0.6rem;
  }
   .legenda-list li {
padding: 0;
   }
   .legenda-popover {
    width: min(150px, 55vw);
  }
    
    #solar-map {
      height: 60vh;
      width: 100%;
      flex: none;
    }
    #container {
      display: flex;
      flex-flow: column-reverse nowrap;
      height: 100vh;
    }
    #mainHomepageSection {
      margin-top: 1rem;
      flex: 1;
      height: 40vh; /* or auto if you want it to fill leftover space */
      overflow-y: auto;
      width: 100%;
    }
.infoCard {
    margin-bottom: 1rem;
  }
  .infoHeadWrapper {
    padding: 5px;
  }
  .infoHeadWrapper .arrow {
    font-size: 1.2rem;
        margin-right: 10px;
  }
    #mainHomepageSection h1 {
      margin: 0;
      font-size: 1.2rem;
    }
    #mainHomepageSection h2 {
      font-size: 1rem;
    }
    #mainHomepageSection h5 {
      font-size: 0.9rem;
    }
  }
</style>

<BaseLayout currentLocale={currentLocale}>
  <div id="container">
    <section id="mainHomepageSection">
      <h1>{pageTitle}</h1>
      <p class="introText">
        O mapa interativo mostra a distribuição geográfica das centrais solares
        existentes, em processo de licenciamento, e projectos de centrais
        solares fotovoltaicas propostos para o território. Esta pesquisa pretende explorar a
        interseção destes projetos com zonas de interesse natural e cultural. 
      </p>
      <p class="funkyList">
        Para explorar o mapa, as várias camadas de informação podem ser adicionadas ou removidas no separador Filtrar. Ao clicar nos elementos do mapa, aparece uma janela com mais informação. 
      </p>
      <p class="note">Nota: Alguns elementos só se tornam visíveis aumentando ou diminuindo o zoom do mapa, pelo que nem todos os elementos estarão visiveís ao mesmo tempo.</p>
        
      <div class="infoCard" id="filtro">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Filtrar</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <nav id="filter-group" class="filter-group"></nav>
        </div>
      </div>
<div class="infoCard" id="listaCentrais">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Listagem de Centrais Solares</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          </div>
      </div>
      
      <div class="infoCard" id="sophia">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Sobre o Projeto Sophia</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <a href="/docs/RELATAssociativoSophia.pdf"  target="_blank">Relatório Formal de oposição ao projeto Central Solar Fotovoltaica (CSF) de Sophia e as Linhas de Muito Alta Tensão (LMAT) associadas</a>
          <p>Resposta à consulta pública desenvolvida colaborativamente por: Movimento Cívico Gardunha Sul, Cidadãos pela Beira Baixa, Sophia Legal Challenge group, associações locais e cidadãos. Constata a não conformidade do Estudo do Impacte Ambiental (EIA) do Projeto CSF Sophia relativamente a vários instrumentos legais, como Diretivas Europeias e legislação portuguesa.  </p>
          <a href="https://cidadaospelabeirabaixa.pt/manifesto/" target="_blank">Manifesto Cidadãos Pela Beira Baixa</a>
          <p>Este manifesto contesta "os megaprojetos “Central Solar Fotovoltaica (CSF) de Sophia e as Linhas de Muito Alta Tensão (LMAT) associadas”, nos concelhos do Fundão, Penamacor e Idanha-a-Nova, e “Central Fotovoltaica da Beira (269 MWP) e Linha Elétrica 220kV de Ligação à RESP”, nos concelhos de Castelo Branco e Idanha-a-Nova.", contendo informação muito relevante e defendendo uma transição energética justa e equilibrada.</p>
          <a href="https://extreme-spoonbill.super.site/" target="_blank">STOP Sophia</a>
          <p>Website com eventos, petições e informação para travar o projeto Sophia.</p>
          <h4>Como analisar um projeto em consulta pública<br>Tomando como exemplo o projeto CSF de Sophia e as LMT associadas, segundo o Estudo de Impacte Ambiental – CSF Sophia (APA, 2024)</h4>
            <p>No caso do projeto Sophia, podemos ver facilmente que há inúmeros documentos anexos à consulta pública. Enquanto cidadãos, o que nos vai interessar mais é o "RNT", o <strong>Resumo Não Técnico</strong> que, como o nome indica, vai sumarizar todo o Estudo de Impacte Ambiental (EIA) em linguagem corrente para ser mais compreensível para o público em geral.</p>
            <p>O RNT vai traduzir o estudo técnico e explicar em que consiste o projeto, os seus impactes ambientais e propostas de mitigação. Eu gosto de ter atenção a:</p>
            <div class="listAnaliseRTE">
              <p><strong>Localização</strong> e <strong>dimensão</strong> do projeto;</p>
              <p><strong>Que zonas de interesse ambiental e cultural estão próximas ao projeto?</strong> (daí o mapa, para que possamos verificar mais facilmente)</p>
              <p><strong>Qual é a atual ocupação do solo?</strong></p>
              <p>Por exemplo, neste caso da Sophia, na página 21 o RTE diz-nos que o solo da Área de Estudo é composto por " áreas naturais e seminaturais, explorações florestais,
explorações agrícolas, áreas artificializadas e áreas invadidas por espÈcies exóticas. Destaca-se a classe
explorações agrícolas, que predomina sobre as restantes, ocupando cerca de 39,51% do total da área
para implantação da Central Fotovoltaica."</p>
                <p><strong>Que espécies ali habitam?</strong> </p>
              <p>Neste caso, são descritos os "povoamentos de azinheira/sobreiro (povoamentos naturais, núcleos e montados), os
carvalhais melhor conservados, os povoamentos florestais de sobreiros de origem silvícola e as
comunidades ribeirinhas de amial, freixial e salgueiral que se desenvolvem ao longo dos cursos de água", "os arrelvados vivazes e os matos de urzal-tojal", e ainda "a presença de sobreiros e de azinheiras, duas espécies com estatuto de proteção legal,
que condiciona o seu abate. Foram ainda observados 4 endemismos ibéricos sem qualquer estatuto de
ameaça." (página 22 e 23). Quanto à fauna, destaco a sobreposição da localização do projeto com "a área Muito Crítica associada a Cegonha-preta, com a área de dormitório de Abutre-preto e com o
território de águia-imperial", pelo que "considera-se que a área de estudo e sua envolvente apresenta um valor de
conservação médio a elevado para as aves." (página 24)</p>
<p>Foram feitos esforços para dar a conhecer à população local o projeto e o que este pressupõe?</p>
<p>Que planos de mitigação foram apresentados para os seguintes temas: biodiversidade, qualidade do ar, da água e do solo, poluição, impactos económicos, sociais e culturais? </p>   
<p>São apresentadas alternativas?</p>  
<p>São apresentados planos de mitigação face aos impactes identificados?</p>         
                </div>
        </div>
      </div>
      <div class="infoCard" id="recursos">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Recursos</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <p class="introText"><strong>Estudos, artigos e notícias relevantes</strong></p>
          
          <a href="https://diariodarepublica.pt/dr/detalhe/resolucao-assembleia-republica/102-2025-913048483" target="_blank">Resolução da Assembleia da República n.º 102/2025, de 31 de março
</a>
<p>Recomendação da Assembleia ao Governo para compatibilizar a produção de energia renovável com a preservação ambiental e social.</p>
<a href="https://www.epj-pv.org/articles/epjpv/pdf/2024/01/pv230071.pdf" target="_blank">Communication on the potential of applied PV in the European
Union: Rooftops, reservoirs, roads (R3)</a>
<p>Estudo sobre o potencial de aplicação de fotovoltaicos em telhados, reservas e infraestruturas rodoviárias. Sublinho o gráfico da página 6, o qual denota o potencial de Portugal em produzir energia fotovoltaica descentralizada.</p>
<a href="https://pdf.sciencedirectassets.com/305759/1-s2.0-S2214629624X00067/1-s2.0-S2214629624001208/main.pdf?X-Amz-Security-Token=IQoJb3JpZ2luX2VjEHEaCXVzLWVhc3QtMSJGMEQCICd6jgakFF2%2F55e7Bhw75Q1HA9t5Fl9xJZCqNiCNZu%2FWAiBaXVMgvRdF6HKZbys7whnvxFr%2FW%2Bpm7g32sk3klGQVviqyBQg6EAUaDDA1OTAwMzU0Njg2NSIMda8veVwJ9hJ2Tr1NKo8Fcr8XmmiBNn1F88WxbT2IaqMKYGE6on7EBO625pxjsnEHOBjEYiYRD36xnyh9v%2BnNoywffJaqyG9z4cyYF%2BeCSo76EcRBeQCp15ndgjgQyX8SjqavcE68bILZAVTFrBIcHFrZsuIHlK1kOXGBHSJFrFaLqroX7ZHMwPpu7ejrYrG4wexzXHQ%2FG61QzS%2FpfO27kYUINKLVjjcBU80gzP5d%2FMZsDMKhdcgE0ifnx%2BYPXk1Mbgi9GjvjW%2F9aKx6JHnNJhLnCj9M926E26vBeCuj%2FHWiob3sKz5eK1KNWVgLwVIdqOsNLZLYZ2Sx8CwyrB3dKiH0EjlkzECemaOmarKB7p3qeDnn%2BOma6BuWT70IEIrgFubi8wtENTrHb1i0LFg3SyfbBc5OvMFaVMH%2BTUfqhDY2jUGUSh7biiRrS1AvTvNuNJ1GggIAsf8oABctujzEuJCZDvhqDJdJbR%2Bsaf32jnVjs334PTdAJAZv1YQ2s5FL4jkWGtEE%2FTlyHwtvepDqXatFtJ2vXn4BZT3Jnvll8EPLm8t8bM3FvcYmzYduYujgLgg3GEyDdRd8yCeXLX6OqJpUzV6V79aanHF3QZznSoU5LGR0EjKlTNOlomNIolmrAI8Lw0e4qvhRBTMJ8Ktb8%2FL8Zr3WIUMIbigLgo1cEaBde5FEGCqLDuynAgXERCWbVN0m25WR9ic5UMZ29k%2B%2BxdNnZXjdB3lrWF3Q7qPZZs7fKzGCp%2F%2BbsXn0M70lMO3jUlte7IfUgnUk%2FNPbdNe22qYa4TD3rB15AQ1eMGfFT%2F%2F5jzGFvtcHWdl4fqGSBOW2mAHVihYrxChwT6u%2FRRqcDUUbocHGDzi9ev91fqK%2BLQFWzI1n2S5nCz0P21kQgyjDV79LIBjqyAQ1jAD4bxUkJxhaKQjzfWOY%2FKp6CNQaTubYi%2BZCdKheoR%2FbhE%2FdryKSadl4lNaSUZYnICc%2BL%2FStFDko8afJ19Zj6BRbMOMPSA8ckdyGLpZ9sm4IQxR64EUssuZEMTRwYt7tgf4appzkBeDwsnDgoLFWd8fyMQmGBvFA9vBX2XVNAFIN%2FFsdDwllWyXBG0Rve9WnmgPulCUaOtaYh5fCgtmAt6AKuAxMc8QXNxT0tJeo1L%2Fs%3D&X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Date=20251112T172102Z&X-Amz-SignedHeaders=host&X-Amz-Expires=300&X-Amz-Credential=ASIAQ3PHCVTY6LFYRFSO%2F20251112%2Fus-east-1%2Fs3%2Faws4_request&X-Amz-Signature=bf167d3ea7ba1a24ad79ab74b93da4f4e97b3ebf427f4acea0556cdd915b0be0&hash=4dfcc16b317da744ece26d5ef9a66ae000c946b929eb22907458d3d20e290303&host=68042c943591013ac2b2430a89b270f6af2c76d8dfd086a07176afe7c76c2c61&pii=S2214629624001208&tid=spdf-1ff33328-bf43-48d6-93ac-6a6548e55d62&sid=71ad5fc553bee349203b8756aed05ab78fd3gxrqb&type=client&tsoh=d3d3LnNjaWVuY2VkaXJlY3QuY29t&rh=d3d3LnNjaWVuY2VkaXJlY3QuY29t&ua=131358590258045154&rr=99d7b4147e615be2&cc=pt"  target="_blank">People of the sun: Local resistance and solar energy (in)justice in
southern Portugal</a>
<p>Estudo de caso sobre resistência local a um projeto para uma central fotovoltaica de grandes dimensões no Cercal, Alentejo.</p>
<a href="https://www.sulinformacao.pt/2024/09/grupo-pro-evora-intenta-acao-em-tribunal-para-tentar-travar-nova-central-solar/" target="_blank">Grupo Pro-Évora intenta ação em tribunal para tentar travar nova central solar</a>
<a href="https://www.sciencedirect.com/science/article/abs/pii/S2352009422000207" target="_blank">Soil properties changes after seven years of ground mounted photovoltaic panels in Central Italy coastal area
</a>
<p>Estudo sobre a influência de paineís fotovoltaicos nas propriedades do solo após 7 anos de instalação. </p>
        </div>
      </div>
      <div class="infoCard" id="consultas">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Criar conta no Portal Participa</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <h4>Passo a passo</h4>
          <ol class="instructionsParticipa">
            <li>Aceder ao <a href="https://participa.pt/"  target="_blank">Portal Participa</a>;</li>
            <li>No canto superior direito, clicar no botão que diz "Registo";</li>
            <li>Clicar em "Individual" e preencher os dados obrigatórios. Se preencherem opcionais, serão informados por email quando houver processos alinhados com os vossos interesses e localização escolhidos.</li>
            <li>Vão receber um email para confirmar um registo. Cliquem no link que receberam nesse email para ativarem a vossa conta.</li>
            <li>Agora já podem submeter comentários a consultas públicas que estejam abertas. </li>
            <li>No caso da CSF de Sophia e as LMT associadas, clicar no <a href="https://participa.pt/pt/consulta/a-csf-de-sophia-e-as-lmat-associadas" target="_blank">link para a o projeto;</a></li>
            <li>Clicar em "Participar";</li>
            <li>Seleccionar a classficação da vossa participação (cof cof "Discordância");</li>
            <li>Preencher o campo de texto com o vosso comentário. Eu tento sempre responder com respeito, de forma concisa e fundamentada. Podem adicionar-se anexos.</li>
            <li>Clicar em "Submeter" e verificar que o comentário foi enviado.</li>
          </ol>
        </div>
      </div>
      
      <div class="infoCard" id="sobre">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Sobre</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <p class="introText">
            Esta página foi criada por mim, cidadã comum, para tornar pública uma pesquisa que fiz para uso pessoal, para poder formar uma opinião sobre as várias centrais fotovoltaicas que estão a ser propostas e implementadas no território onde habito, trabalho, amo, viajo, etc; e informar as submissões que tenho feito a consultas públicas de projetos deste género.</p>
 <p class="introText">Também facilita em conversa informal, quando o tema surge e a resposta mais frequente é a de distanciamento por “ser muito complicado”. É exatamente pela sua complexidade que urge debater o assunto, estudar e refletir para que possamos tomar decisões conscientes que garantam o futuro de todos nós e de todas as espécies que connosco habitam por aqui. </p>
 <p class="introText">O objetivo desta pesquisa não é a rejeição de centrais solares, mas para que a transição energética seja feita com o respeito e a reverência necessários ao nosso território e património cultural, sem cair nos mesmos erros do passado de destruição de ecossistemas por preguiça e lucro fácil. No separador recursos podem encontrar estudos sobre o potencial da energia solar descentralizada em Portugal, entre outros estudos que achei interessantes, para que cada um possa explorar o tema à sua vontade e formar a sua própria opinião. </p>
          
        </div>
      </div>
      <div class="infoCard" id="fontes">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Fontes</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <ul>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources" target="_blank"
              >
                <span>Centrais Solares existentes e em licenciamento, DGEG - Direção-Geral de Energia e Geologia (DGT)</span>
              </a>
            </li>
            <li>
                <span>Centrais Solares propostas - informação aproximada, recolhida através da localização dos projetos no Portal Participa</span>
            </li>
            <li>
              <a
                href="https://sig.icnf.pt/portal/home/item.html?id=030837b14f634e64bda881f199f5b086" target="_blank"
              >
                <span>ICNF, Rede Nacional de Geoparques UNESCO), 9/11/2025</span>
              </a>
            </li>
