---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle =
  "Centrais Solares e interação com zonas de interesse ambiental e cultural";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---

<link
  href="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.css"
  rel="stylesheet"
/>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.js"
></script>

<style>
  #solar-map {
    height: 100vh;
    width: 60%;
  }
  body {
    background-color: var(--background-cream);
    background-size: cover;
    background-repeat: no-repeat;
    height: 100%;
    max-height: 100vh;
    margin: 0;
  }
  .prop-publica1,
  .site_code,
  .gid,
  .publica1 {
    display: none !important;
  }
  .container {
    display: flex;
    flex-flow: row nowrap;
    height: 100vh;
    overflow: hidden;
  }
  .mainHomepageSection {
    padding: 1rem;
    width: 40%;
    height: 100%; /* fill vertical space */
    overflow-y: auto; /* only this scrolls */
    box-sizing: border-box;
    font-family: var(--text-font);
  }
  .infoCard {
    border: 2px sold var(--dark-brown);
  }
  .mainHomepageSection h1 {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--dark-brown);
  }
  .mainHomepageSection h2 {
    font-size: 1.2rem;
    color: whitesmoke;
  }
  .mainHomepageSection h5 {
    font-size: 1rem;
  }
  /* Icon key list */
  .mainHomepageSection ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  #fontes li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  /* --- Key Button --- */
  /* button (stick it bottom-right; swap to absolute if you want it inside a map container) */
  .legenda-toggle {
    position: absolute;
    left: 42vw;
    top: 1rem;
    border: 0;
    padding: 0.4rem;
    border-radius: 0.6rem;
    background: var(--dark-brown);
    color: var(--background-cream);
    cursor: pointer;
    font-family: var(--text-font);
    border: 2px solid var(--dark-brown);
  }
  .legenda-toggle:hover {
    background: var(--background-cream);
    color: var(--dark-brown);
    border: 2px solid var(--dark-brown);
  }
  /* Popover */
  .legenda-popover[hidden] {
    display: none !important;
  }
  .legenda-popover {
    position: fixed; /* anchors to viewport; JS keeps it under the button */
    z-index: 9999;
    background: var(--background-cream);
    color: var(--dark-brown);
    border: 1px solid var(--background-cream);
    border-radius: 0.7rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
    padding: 0.6rem 0.6rem 1rem;
    width: min(250px, 85vw);
    max-height: 70vh;
    overflow: auto;
  }
  .legenda-x {
    position: absolute;
    right: 1rem;
    border: 0;
    background: transparent;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.35rem;
  }
  .legenda-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    font-family: var(--text-font);
    font-size: 10px;
  }
  .legenda-list li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.1rem 0.25rem;
  }
  .legenda-list img {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    object-fit: contain;
  }

  /* Dropdown Cards */
  .infoCard {
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .infoHeadWrapper {
    cursor: pointer;
    display: flex;
    flex-flow: row nowrap;
    justify-content: space-between;
    align-items: center;
    background-color: var(--dark-brown);
    border-radius: 20px 20px 0px 0px;
    padding: 10px;
  }
  .infoHeadWrapper h2 {
    margin: 10px;
  }
  .infoHeadWrapper .arrow {
    color: whitesmoke;
    font-size: 1.5rem;
  }
  .contentContainer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    border: 2px solid transparent;
  }

  .infoCard.active .contentContainer {
    max-height: 100%; /* adjust based on your content */
    border: 2px solid var(--dark-brown);
    border-radius: 0px 0px 20px 20px;
    padding: 10px;
  }

  .arrow {
    transition: transform 0.3s ease;
  }

  .infoCard.active .arrow {
    transform: rotate(180deg);
  }
  /*filter */
  #filter-group {
  display: flex;
  flex-direction: column;
  gap: 6px; /* space between rows */
}

#filter-group input[type="checkbox"] {
  margin-right: 6px;
}

#filter-group label {
  display: inline-block;
}

  /* Media Queries - Phones */

  @media (max-width: 481px) {
    .legenda-toggle {
    left: 1rem;
    top: 1rem;
    padding: 0.4rem;
    border-radius: 0.6rem;
  }
   .legenda-list li {
padding: 0;
   }
   .legenda-popover {
    width: min(150px, 55vw);
  }
    
    #solar-map {
      height: 60vh;
      width: 100%;
      flex: none;
    }
    .container {
      display: flex;
      flex-flow: column-reverse nowrap;
      height: 100vh;
    }
    .mainHomepageSection {
      margin-top: 1rem;
      flex: 1;
      height: 40vh; /* or auto if you want it to fill leftover space */
      overflow-y: auto;
      width: 100%;
    }

    .mainHomepageSection h1 {
      margin: 0;
      font-size: 1.2rem;
    }
    .mainHomepageSection h2 {
      font-size: 1rem;
    }
    .mainHomepageSection h5 {
      font-size: 0.9rem;
    }
  }
</style>

<BaseLayout currentLocale={currentLocale}>
  <div class="container">
    <section class="mainHomepageSection">
      <h1>{pageTitle}</h1>
      <p class="introText">
        O mapa interativo mostra a distribuição geográfica das centrais solares
        existentes, em processo de licenciamento, e projectos de centrais
        solares fotovoltaicas propostos para o território. Esta pesquisa pretende explorar a
        interseção destes projetos com zonas de interesse natural e cultural. 
      </p>
      <p class="funkyList">
        Para explorar o mapa, as várias camadas de informação podem ser adicionadas ou removidas no separador Filtrar. Ao clicar nos elementos do mapa, aparece uma janela com mais informação. 
      </p>
      <p class="note">Nota: Alguns elementos só se tornam visíveis aumentando ou diminuindo o zoom do mapa, pelo que nem todos os elementos estão visiveís dependendo do nível de zoom.</p>
        
      <div class="infoCard" id="filtro">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Filtrar</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <nav id="filter-group" class="filter-group"></nav>
        </div>
      </div>
<div class="infoCard" id="listaCentrais">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Listagem de Centrais Solares</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          </div>
      </div>
      <div class="infoCard" id="fontes">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Fontes</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <ul>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources"
              >
                <span>Centrais Solares existentes e em licenciamento</span>
              </a>
            </li>
            <li>
              <a href="">
                <span>Centrais Solares propostas</span>
              </a>
            </li>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources "
              >
                <span>Geoparques</span>
              </a>
            </li>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources "
              >
                <span>RNAP</span>
              </a>
            </li>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources "
              >
                <span>Rede Natura 2000 ZPE</span>
              </a>
            </li>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources "
              >
                <span>Rede Natura 2000 ZEC</span>
              </a>
            </li>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources "
              >
                <span>Rede Natura 2000 SIC</span>
              </a>
            </li>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources "
              >
                <span
                  >Património Cultural - Monumento Nacional & Património Mundial</span
                >
              </a>
            </li>
            <li>
              <a
                href="https://dados.gov.pt/pt/datasets/centrais-solares/#/resources "
              >
                <span
                  >Património Cultural - Monumento de Interesse Público & Sítio
                  de Interesse Público</span
                >
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="infoCard" id="recursos">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Recursos</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <p class="introText">
            O mapa interativo mostra a distribuição geográfica das centrais
            solares existentes, em processo de licenciamento, e projectos de
            centrais solares fotovoltaicas propostos para o território. O mapa
            explora a interseção destes projetos com zonas de interesse natural
            e cultural.
          </p>
        </div>
      </div>
      <div class="infoCard" id="consultas">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Consultas Públicas</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <h4>Criar conta no Portal Participa</h6>
          <ol>
            <li>Aceder ao <a href="https://participa.pt/">Portal Participa</a></li>
            <li>No canto superior direito, clicar no botão que diz "Registo"</li>
            <li>Clicar em "Individual" e preencher os dados obrigatórios. Se preencherem opcionais, serão informados por email quando houver processos alinhados com os vossos interesses e localização escolhidos.</li>
            <li>Vão receber um email para confirmar um registo. Cliquem no link que receberam nesse email para ativarem a vossa conta.</li>
            <li>Agora já podem submeter comentários a consultas públicas que estejam abertas. </li>
            <li>No caso da CSF de Sophia e as LMT associadas, cliquem no <a href="https://participa.pt/pt/consulta/a-csf-de-sophia-e-as-lmat-associadas">link para a o projeto;</a></li>
            <li>Clicar em "Participar"</li>
            <li>Seleccionar a classficação da vossa participação (cof cof "Discordância")</li>
            <li>Preencher o campo de texto com o vosso comentário. Eu tento sempre responder com respeito, de forma concisa e fundamentada. Podem adicionar anexos se quiserem.</li>
            <li>Clicar em "Submeter" e verificar que o comentário foi enviado.</li>
          </ol>
          <h4>Como analisar um projeto em consulta pública</h6>
            <p>No caso do projeto Sophia, podemos ver facilmente que há inúmeros documentos anexos à consulta pública. Enquanto cidadãos, o que nos vai interessar mais é o "RNT", o <strong>Resumo Não Técnico.</strong></p>
        </div>
      </div>
      <div class="infoCard" id="sobre">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Sobre</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <p class="introText">
            Esta página foi criada por mim, cidadã comum, para tornar pública uma pesquisa que fiz para uso pessoal, para poder formar uma opinião sobre as várias centrais fotovoltaicas que estão a ser propostas e implementadas no território onde habito, trabalho, amo, viajo, etc; e informar as submissões que tenho feito a consultas públicas de projetos deste género.</p>
 <p class="introText">Também facilita em conversa informal, quando o tema surge e a resposta mais frequente é a de distanciamento por “ser muito complicado”. É exatamente pela sua complexidade que urge debater o assunto, estudar e refletir para que possamos tomar decisões conscientes que garantam o futuro de todos nós e de todas as espécies que connosco habitam por aqui. </p>
 <p class="introText">O objetivo desta pesquisa não é a rejeição de centrais solares, mas para que a transição energética seja feita com o respeito e a reverência necessários ao nosso território e património cultural, sem cair nos mesmos erros do passado de destruição de ecossistemas por preguiça e lucro fácil. No separador recursos podem encontrar estudos sobre o potencial da energia solar descentralizada em Portugal, entre outros estudos que achei interessantes, para que cada um possa explorar o tema à sua vontade e formar a sua própria opinião. </p>
          
        </div>
      </div>
     
    </section>
    <div id="solar-map"></div>

    <button id="legenda-btn" class="legenda-toggle">Legenda</button>
    <div id="legenda-popover" class="legenda-popover" hidden>
        <button id="legenda-close" class="legenda-x" aria-label="Close"
          >✕</button>

      <ul class="legenda-list">
        <li>
          <img
            src="/images/solaricons/Centrais Solares existentes e em licenciamento.svg"
            alt="Centrais Solares existentes e em licenciamento"
          />
          <span>Centrais Solares existentes e em licenciamento</span>
        </li>
        <li>
          <img
            src="/images/solaricons/Centrais Solares propostas.svg"
            alt="Centrais Solares propostas"
          />
          <span>Centrais Solares propostas</span>
        </li>
        <li>
          <img src="/images/solaricons/Geoparques.svg" alt="Geoparques" /><span
            >Geoparques</span>
        </li>
        <li>
          <img src="/images/solaricons/RNAP.svg" alt="RNAP" /><span>RNAP</span>
        </li>
        <li>
          <img
            src="/images/solaricons/Rede Natura 2000 ZPE.svg"
            alt="Rede Natura 2000 ZPE"
          /><span>Rede Natura 2000 ZPE</span>
        </li>
        <li>
          <img
            src="/images/solaricons/Rede Natura 2000 ZEC.svg"
            alt="Rede Natura 2000 ZEC"
          /><span>Rede Natura 2000 ZEC</span>
        </li>
        <li>
          <img
            src="/images/solaricons/Rede Natura 2000 SIC.svg"
            alt="Rede Natura 2000 SIC"
          /><span>Rede Natura 2000 SIC</span>
        </li>
        <li>
          <img
            src="/images/solaricons/Cultura - MN PM.svg"
            alt="Património Cultural - MN & PM"
          /><span
            >Património Cultural - Monumento Nacional & Património Mundial</span>
        </li>
        <li>
          <img
            src="/images/solaricons/Cultura MIP e SIP.svg"
            alt="Património Cultural - MIP & SIP"
          /><span
            >Património Cultural - Monumento de Interesse Público & Sítio de
            Interesse Público</span>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>
<script>
  import "../scripts/solarmap.js";
</script>
