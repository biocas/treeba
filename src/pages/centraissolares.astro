---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Centrais Solares";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---
<link href="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.js"></script>

<style>
    #solar-map {
    height: 100vh;
    width: 60%;
}
  body {
    background-color: #fff3df;
    background-size: cover;
    background-repeat: no-repeat;
    height: 100%;
    max-height: 100vh;
    margin: 0;
  }
  .container {
    display: flex;
    flex-flow: row nowrap;
  }
  .mainHomepageSection {
    padding: 1rem;
     width: 40%;
  }
  .mainHomepageSection h1{
    font-size: 3.1rem;
    font-family: var(--text-font); 
  }
  .mainHomepageSection h2 {
  font-size: 1.8rem;
  font-family: var(--text-font); 
}
  .mainHomepageSection h5 {
  font-size: 1.5rem;
}
</style>

<BaseLayout currentLocale={currentLocale}>
  <div class="container">
    <section class="mainHomepageSection">
      <h1 class="whiteAndStroke">{pageTitle}</h1>
      <div class="infoCard">
      <h2 class="infoHeading">Filtrar</h2>
      <nav id="filter-group" class="filter-group"></nav>
      </div>
      
    </section>
      <div id="solar-map"></div>
  </div>
</BaseLayout>
<!-- Link to the JavaScript file for interactivity -->
<script src="/src/scripts/solarmap.js" defer>
</script>
