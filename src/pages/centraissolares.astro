---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle =
  "Centrais Solares e interação com zonas de interesse ambiental e cultural";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---

<link
  href="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.css"
  rel="stylesheet"
/>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.js"
></script>

<style>
  #solar-map {
    height: 100vh;
    width: 60%;
  }
  body {
    background-color: #fff3df;
    background-size: cover;
    background-repeat: no-repeat;
    height: 100%;
    max-height: 100vh;
    margin: 0;
  }
  .prop-publica1,
  .site_code,
  .gid,
  .publica1 {
    display: none !important;
  }
  .container {
    display: flex;
    flex-flow: row nowrap;
    height: 100vh; 
    overflow: hidden; 
  }
  .mainHomepageSection {
    padding: 1rem;
    width: 40%;
    height: 100%;                 /* fill vertical space */
  overflow-y: auto;             /* only this scrolls */
  box-sizing: border-box;
  }
  .infoCard {
    border: 2px sold var(--dark-brown);
  }
  .mainHomepageSection h1 {
    font-size: 1.8rem;
    font-weight: 600;
    font-family: var(--text-font);
    color: var(--dark-brown);
  }
  .mainHomepageSection h2 {
    font-size: 1.2rem;
    font-family: var(--text-font);
    color: whitesmoke;
  }
  .mainHomepageSection h5 {
    font-size: 1rem;
  }
  /* Dropdown Cards */
  .infoCard {
  overflow: hidden;
  margin-bottom: 2rem;
  }
.infoHeadWrapper {
  cursor: pointer;
  display: flex;
  flex-flow: row nowrap;
  justify-content: space-between;
  align-items: center;
  background-color: var(--dark-brown);
    border-radius: 20px 20px 0px 0px;
    padding: 10px;
}
.infoHeadWrapper h2 {
  margin: 10px;
}
.infoHeadWrapper .arrow {
  color: whitesmoke;
  font-size: 1.5rem;
}
.contentContainer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  border: 2px solid transparent;
}

.infoCard.active .contentContainer {
  max-height: 500px; /* adjust based on your content */
  border: 2px solid var(--dark-brown);
  border-radius: 0px 0px 20px 20px;
  padding: 10px;
}

.arrow {
  transition: transform 0.3s ease;
}

.infoCard.active .arrow {
  transform: rotate(180deg);
}
  /* Media Queries - Phones */
  @media (max-width: 481px) {
    #solar-map {
      height: 60vh;
      width: 100%;
      flex: none;  
    }
    .container {
      display: flex;
      flex-flow: column-reverse nowrap;
      height: 100vh;
    }
    .mainHomepageSection {
    flex: 1;
    height: 40vh;                /* or auto if you want it to fill leftover space */
    overflow-y: auto;
    width: 100%;
  }

    .mainHomepageSection h1 {
      margin: 0;
      font-size: 1.2rem;
    }
    .mainHomepageSection h2 {
      font-size: 1rem;
    }
    .mainHomepageSection h5 {
      font-size: 0.9rem;
    }
  }
</style>

<BaseLayout currentLocale={currentLocale}>
  <div class="container">
    <section class="mainHomepageSection">
      <h1>{pageTitle}</h1>
      <p class="introText">
        O mapa interativo mostra a distribuição geográfica das centrais solares
        existentes, em processo de licenciamento, e projectos de centrais
        solares fotovoltaicas propostos para o território. O mapa explora a
        interseção destes projetos com zonas de interesse natural e cultural.
      </p>
      <div class="infoCard" id="filtro">
        <div class="infoHeadWrapper">
          <h2 class="infoHeading">Filtrar</h2>
          <span class="arrow">&#9662;</span>
        </div>
        <div class="contentContainer">
          <nav id="filter-group" class="filter-group"></nav>
          <p class="introText">
        O mapa interativo mostra a distribuição geográfica das centrais solares
