---
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
const pageTitle = "Treeba";
import HomepageCard from "../layouts/homepageCard.astro";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---

<style>
  body {
    background-image: url("/images/rootsBckHome.png");
    background-color: var(--primary-orange);
    background-size: cover;
    background-repeat: no-repeat;
    height: 100%;
    max-height: 100vh;
    overflow: hidden;
  }
  .container {
    display: flex;
    flex-flow: row nowrap;
    gap: 3.5rem;
    margin: 3rem 2rem 3rem 4rem;
  }
  .treebaLogo {
    width: 30vw;
  }
  .mainHomepageSection {
    background-color: var(--background-cream);
    border: 2px solid var(--primary-green);
    padding: 20px;
    border-radius: 20px;
    box-shadow: 10px 10px var(--primary-green);
    display: flex;
    align-items: center;
    flex-flow: column wrap;
    gap: 10px;
  }
  .homeAboutText {
    color: var(--dark-brown);
  }
  .cardWrapper {
    margin-top: 5rem;
    display: flex;
    align-items: center;
    flex-flow: column wrap;
    gap: 10px;
  }
  .cardWrapperBottom {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    flex-flow: row wrap;
    gap: 10px;
  }
  @media (max-width: 481px) {
    body {
    height: 100vh;
        max-height: none;
  }
  .container {
    gap: 0;
    margin: 1.5rem;
  }
.mainHomepageSection h5{
    margin: 1rem 0 1.5rem 0;
  }
  }
</style>

<BaseLayout currentLocale={currentLocale}>
  <LanguagePicker />
  <div class="container">
    <div class="cardWrapper">
<HomepageCard image="/images/favicon.svg" href="/lore/" name="Lore" />
        <HomepageCard image="/images/forest.svg" href="forest/" name="Forest" />
    </div>
    <div class="middleWrapper">
<section class="mainHomepageSection">
      <img class="treebaLogo" alt="Treeba" src="/images/Treeba.svg">
      <h5 class="homeAboutText">
        Digital woodlands where regenerative work germinates and grows, fruits
        and decays, eventually composting, circling in tender connections and
        the hopeful flow of gifts. Focused on the Iberian Peninsula.
      </h5>
    
    </section>
    <div class="cardWrapperBottom"><HomepageCard image="/images/map.svg" href="/map/" name="Map" />
        <HomepageCard
          image="/images/bee.svg"
          href="/bookshelf/"
          name="Books"
        /></div>
    </div>
    
        <div class="cardWrapper"> <HomepageCard image="/images/berry.svg" href="/forage/" name="Forage" />
        <HomepageCard
          image="/images/flower.svg"
          href="/margarida/"
          name="About"
        /></div>
  </div>
</BaseLayout>

