---
//<bg-sound src="https://geocities.restorativland.org/Area51/Shadowlands/1272/alliance.mid" loop="true" baseurl="/_assets/midi/"></bg-sound>

import { getCollection } from "astro:content";
const posts = await getCollection('blog');
const publishedPosts = posts.filter((post) => !post.data.draft);
const tags = [...new Set(publishedPosts.map((post: any) => post.data.tags).flat())];
const growthStages = [...new Set(publishedPosts.map((post: any) => post.data.growthStage).flat())];
const topics = [...new Set(publishedPosts.map((post: any) => post.data.topics).flat())];
const formats = [...new Set(publishedPosts.map((post: any) => post.data.format).flat())];
const { frontmatter } = Astro.props;
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
const pageTitle = "Treeba";
import HomepageCard from "../layouts/homepageCard.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
const currentLocale = Astro.currentLocale; // Get the current locale (e.g., 'en', 'es', 'fr')
export async function getStaticPaths() {
  return ["en", "pt"].map((lang) => {
    return { params: { lang } };
  });
}
---

<style>
  body {
    background-image: url("/images/treeba home bck.png");
    background-color: var(--primary-orange);
    background-size: cover;
    background-repeat: no-repeat;
    
  }
  
  .homeContent {
    display: flex;
    flex-flow: row nowrap;
    gap: 5rem;
    margin: 0rem 2rem 5rem;
  }
  .cardWrapper {
   padding: 0 4vw;
    display: flex;
    flex-flow: column wrap;
    gap: 10px;
  }
  .contentBar {
    margin-right: 2rem;
    gap: 2rem;
  }
  .contentBox {
    display: flex;
    flex-flow: column nowrap;
    align-items: stretch;
    gap: 10px;
    background-color: var(--transparent-orange);
    border-radius: var(--border-radius-base);
    border: 4px solid var(--primary-orange);
    padding: 10px;
    height: 80%;
  }
  .FeedContentWrapper {
    background-color: var(--transparent-yellow);
    border-radius: var(--border-radius-base);
    border: 4px solid var(--primary-blue);
    padding: 10px;
    flex-grow: 1;
    overflow-y: scroll;
  }
  @media only screen and (min-width: 768px) {
   .cardWrapper {
   padding: 0 2vw;
  }
.contentBox {
    margin-top: 3rem;
  }
  .homeContent {
    margin: 0rem 0rem 5rem;
    gap: 3rem;
  }
  }
  @media only screen and (max-width: 767px) {
    .contentBar {
    margin: 0 1.5rem;
  }
  .homeContent {
    margin: 0;
    flex-flow: column nowrap;
    gap: 2rem;
  }
  .cardWrapper {
    padding: 0 2vw;
    margin: 1rem 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, auto);
    gap: 2vh 12vw;
    justify-items: center;
  }
  .FeedContentWrapper{ height: 90vh;}
  }
</style>

<BaseLayout currentLocale={currentLocale}>
  <div class="container">
    <h1 class="mainTreebaTitle">Treeba</h1>
    <section class="homeContent"> 
      <div class="cardWrapper">
<HomepageCard image="/images/favicon.svg" href="/lore/" name="Lore" />
        <HomepageCard image="/images/forest.svg" href="/forest/" name="Forest" />
        <HomepageCard
          image="/images/flower.svg"
          href="/margarida/"
          name="About"
        />
        <HomepageCard
          image="/images/bee.svg"
          href="/bookshelf/"
          name="Resources"
        />
        
        <HomepageCard image="/images/berry.svg" href="/forage/" name="Forage" />
        <HomepageCard image="/images/map.svg" href="/preserv/" name="My Maps" />
        
    </div>
    <div class="contentBar">
<h5 class="whiteAndStroke introHome">
       Hello world! I am Margarida Salvado, from West Iberia. Welcome to my digital woodlands, where I gather findings from inner and outer territories, finding paths for expression, spiralling in tender connections and the hopeful flow of gifts, germinating, budding, branching off or decaying, eventually composting.
      </h5>
      <section class="wrapBase contentBox">
      <Navigation/>
      <div class="FeedContentWrapper">
         <h6>What has been tended to lately in these woods?</h6>
<BlogPost/>
<h6>Themes</h6>
<ul class="postsGrowthStages">
    <li>
    {topics.map((topic) => <a href={`/themes/${topic}`}>{topic}</a>)}
    </li>
</ul>
 <h6>Tags</h6>
<ul class="postsTags">
    <li>
    {tags.map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}
    </li>
</ul>

<h6>Growth Stage</h6>
<ul class="postsGrowthStages">
    <li>
    {growthStages.map((growthStage) => <a href={`/tags/${growthStage}`}>{growthStage}</a>)}
    </li>
</ul>
<h6>Format</h6>
<ul class="postsGrowthStages">
    <li>
    {formats.map((format) => <a href={`/tags/${format}`}>{format}</a>)}
    </li>
</ul>
      </div>
      </section>
    </div>
    </section>
    
  </div>

</BaseLayout>


