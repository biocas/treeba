---
import Navigation from "../components/Navigation.astro";
---
<section class="wrapper"> 
    <Navigation />
    <div class="greenTextSection">
       <slot />
    </div>
</section>
<style>
    .wrapper {
        background-color: #A0DF33B0;
        border: 4px solid var(--stroke-green);
        border-radius: 40px;
        padding: 20px;
        width: 40vw;
        margin-bottom: 1.5rem;
        height: 95vh;
    }
    .greenTextSection {
        background-color: #C3EB80;
        border: 2px solid var(--stroke-green);
        border-radius: 40px;
        height: 80%;
    }
    @media (max-width: 481px) {
  .wrapper {
    display: none;
  }
}

</style>