---
//code from https://github.com/rebelchris/astro-modal 
const {id, open} = Astro.props;
---
<style>

dialog {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  
}
dialog::backdrop {
    position: fixed;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    background: rgba(255, 0, 0, 0.1);
  }
</style>
<dialog id={id} class="resourceModal">
    <slot name="close" />
  <slot name="main" />
  <form method="dialog">
  </form>
</dialog>


