---
import { getCollection } from "astro:content";
const posts = await getCollection('blog');
const publishedPosts = posts.filter((post) => !post.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => Date.parse(b.data.lastUpdated.toDateString()) - Date.parse(a.data.lastUpdated.toDateString()));

const tags = [...new Set(publishedPosts.map((post: any) => post.data.tags).flat())];
const growthStages = [...new Set(publishedPosts.map((post: any) => post.data.growthStage).flat())];
const { frontmatter } = Astro.props;
---
<ul class="latestPosts">
  {sortedPosts.map(post => (
    <li>
      <a href={`/blog/${post.id}/`} class="postTitle">
        {post.data.title}
      </a>
    </li>
  ))}
</ul>