---
import Modal from "../components/Modal.astro";
const { title, author, description, id, imageURL, link, tags, topics, yearOfPublication} = Astro.props;
const iconArray = ['/images/bee.svg', '/images/bird.svg', '/images/butterfly.svg', '/images/cherries.svg', '/images/favicon.svg', '/images/Fox.svg', '/images/ladybug.svg', '/images/oak leaf.svg', '/images/plant.svg', '/images/tree.svg', '/images/sun.svg']; 
const randomElement = iconArray[Math.floor(Math.random() * iconArray.length)];
---
<style>
.resourceTextOnly {
    font-family: var(--text-font);
    color:white;
    font-weight: 400;
}
.linkWrapper {
    display: flex;
    flex-flow: row;
  align-items: center;
  gap: 0.5rem;
}
.linkWrapper:hover img {
    transform: rotate(-20deg);
}
.linkWrapper:hover .resourceTextOnly {
    transform: translateY(-5px);
color: #1700EE;
text-decoration: underline;
}
</style>
<div class="moonHover linkWrapper" id={`${id}ModalBttn`}>
    <img class='icon' src={randomElement}/>
        <h5 class="resourceTextOnly">{title}</h5>
</div>
<Modal id={`${id}ModalEl`}  open="OpenModal">
        <button class="closeBttn moonHover" id={`${id}closeBttn`} slot="close">X</button>
        <main slot="main">
          <p class="resourceModalTitle">{title}</p>
          <a target="_blank"
	rel="noopener noreferrer" class="bodyPageLinks moonHover" href={link}>Go to resource</a>
    {(author ||yearOfPublication) && <div class="linkDeets"><p>{author}</p>
          <p>{yearOfPublication}</p></div>}
          {description && <p class="resourceModalDescription">{description}</p>}
           <h6  class="fineHeadings">TOPICS</h6>
<div class="tagsWrapper">{
          topics.map((topic) => {
            return (
                <a class="resourceModalPills" href={`/blog/topic/${topic.toLowerCase()}/`}>
                  {topic.toLowerCase()}
                </a>
            );
          })
        }</div>
       <h6 class="fineHeadings">TAGS</h6>
        <div class="tagsWrapper">{
          tags.map((tag) => {
            return (
                <a class="resourceModalPills" href={`/blog/tags/${tag.toLowerCase()}/`}>
                  {tag.toLowerCase()}
                </a>
            );
          })
        }</div>
        </main>
      </Modal>
<script define:vars={{ id }}>
  document.addEventListener("DOMContentLoaded", () => {
    const dialog = document.getElementById(`${id}ModalEl`);
    const showButton = document.getElementById(`${id}ModalBttn`);
    const closeButton = document.getElementById(`${id}closeBttn`);
    if (dialog) {
      // "Show the dialog" button opens the dialog modally
      showButton.addEventListener("click", () => {
        dialog.showModal();
      });

      // "Close" button closes the dialog
      closeButton.addEventListener("click", () => {
        dialog.close();
      });

      // "Click" outside the dialog closes it
      dialog.addEventListener("click", event => {
        // console.log("clicked: ", event.target, event.currentTarget);
        if (event.target === dialog && event.currentTarget === dialog) {
          dialog.close();
        }
      });
    } else {
      console.error("Dialog elements not found:", {
        dialog,
        showButton,
        closeButton
      });
    }
  });
</script>
