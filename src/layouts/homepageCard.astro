---
const { image, href, name } = Astro.props;
---

<a class="card moonHover" href={href}>
    <img src={image} class="card-img-top" alt={name} />
    <div class="wrapper">
    <h2 class="card-title">{name}</h2>
    </div>
</a>


<style>
    .card {
        text-decoration: none;
        width: 20vw;
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        gap: 10px;
    }
    .card:hover {
        transform: scale(1.1);
    }
    .card-img-top {
        width: 120px;
    }
    .card-img-top:hover {
        transform: rotate(-10deg);
    }
    .card-title {
        font-family: var(--title-font);
       color: var(--secondary-yellow);
  -webkit-text-stroke-width: 0.8px;
  -webkit-text-stroke-color: var(--primary-orange);
  font-size: 1.379rem;
    }
    @media (max-width: 481px) { 
        .card-img-top {
        width: 100px;
    }
    .card {
        flex-flow: column wrap;
        align-items: center;
        flex-basis: 0%;
    }
        } 
</style>
