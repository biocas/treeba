---
const { image, href, name, id } = Astro.props;
---

<a id={id} class="card moonHover" href={href}>
    <img src={image} class="card-img-top" alt={name} />
    <div class="wrapper">
    <h2 class="card-title">{name}</h2>
    </div>
</a>


<style>
    .card {
        text-decoration: none;
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        gap: 10px;
    }
    .card:hover {
        transform: scale(1.1);
    }
    .card-img-top {
        width: 120px;
    }
    .card-img-top:hover {
        transform: rotate(-10deg);
    }
    .card-title {
        font-family: var(--title-font);
       color: var(--secondary-yellow);
  -webkit-text-stroke-width: 0.8px;
  -webkit-text-stroke-color: var(--primary-orange);
  font-size: 1.379rem;
  text-align: center;
    }
   @media only screen and (max-width: 767px) { 
    .card-title {
        font-size: 10px;
        margin: 0;
  -webkit-text-stroke-width: 0.4px;
    }
        .card-img-top {
        width: 100%;
    }
    .card {
        flex-flow: column wrap;
        align-items: center;
    }
    #basket {
        width: 25vw;
    }
        } 
        
</style>
