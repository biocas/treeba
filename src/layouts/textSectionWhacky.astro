---
const { color, border, width, textColour, alignSelf } = Astro.props;
---

<section class="textSectionWacky">
    <slot />
 </section>

  <style define:vars={{ color , border, width, textColour, alignSelf }}>
.textSectionWacky {
    background-color: var(--color);
    padding: 1rem;
    border: var(--border);
    width: var(--width);
    color: var(--textColour);
    align-self: var(--alignSelf);
}
  </style>